		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{ "slug": "steel-950", "name": "Steel 950", "color": "#121417" },
				{ "slug": "steel-900", "name": "Steel 900", "color": "#1a1e24" },
				{ "slug": "brass", "name": "Brass", "color": "#b8872c" },
				{ "slug": "brass-glow", "name": "Brass Glow", "color": "#d4a84b" },
